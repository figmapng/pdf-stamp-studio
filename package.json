{
  "name": "pdf-stamp-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Local-first browser-side PDF signature & stamp placement studio with multi-language OCR, anchor detection, and manual review.",
  "scripts": {
    "postinstall": "node scripts/copy-vendor.mjs",
    "sync-vendor": "node scripts/copy-vendor.mjs",
    "dev": "vite",
    "build": "node scripts/copy-vendor.mjs && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:benchmark": "vitest run tests/integration/benchmark.test.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@techstark/opencv-js": "^5.0.0-release.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "idb": "^8.0.4",
    "jszip": "^3.10.2",
    "lucide-react": "^1.72.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.8.3",
    "vitest": "^4.1.0"
  }
}
