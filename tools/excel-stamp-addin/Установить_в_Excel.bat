@echo off
chcp 65001 >nul
title Установка надстройки PDF Stamp Studio в Microsoft Excel
cls
echo =========================================================================
echo  PDF Stamp Studio — Установка надстройки в Microsoft Excel
echo  (ТОО «Ecology Expert» — Подписи и печать для протоколов)
echo =========================================================================
echo.
echo [1/3] Проверка прав и запуск установщика...
echo.

powershell.exe -NoProfile -ExecutionPolicy Bypass -File "%~dp0install.ps1"

if %ERRORLEVEL% EQU 0 (
    echo.
    echo =========================================================================
    echo  [УСПЕХ] Надстройка успешно установлена!
    echo  Теперь откройте Microsoft Excel и проверьте вкладку "Главная".
    echo  Там появилась большая кнопка: "Создать PDF с подписями".
    echo  Также работает сочетание клавиш: Ctrl + Shift + P
    echo =========================================================================
) else (
    echo.
    echo [ОШИБКА] Произошел сбой при установке. 
    echo Убедитесь, что Microsoft Excel закрыт перед установкой, и повторите.
)

echo.
pause
